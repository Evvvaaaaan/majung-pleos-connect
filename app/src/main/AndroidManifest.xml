<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 무설치 동승자 안심 웹 중계 서버(SSE/REST) 통신 권한 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      [Pleos Connect 공식 공개 권한 선언 — 비공개 PRIVATE_* 권한 미사용]
      Ref: https://document.pleos.ai/docs/pleos-only/getting-started (Step 4: CAR_DOORS)
      Ref: https://document.pleos.ai/en/docs/pleos-only/connect-sdk-pleos/Vehicle/permissions
    -->
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_SPEED" />
    <uses-permission android:name="pleos.car.permission.READ_CAR_STEERING" />
    <uses-permission android:name="pleos.car.permission.READ_WINDSHIELD_WIPERS" />

    <!-- FusedLocation(1.1.2) · NaviHelper(3.0.5) · TextToSpeech(3.3.1) · SpeechToText(3.3.1) 권한 -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />

    <application
        android:allowBackup="false"
        android:label="마중 (MAJUNG)"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">

        <uses-library
            android:name="android.car"
            android:required="false" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="START_SAFE_PICKUP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".gleo.GleoActionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="SHARE_PICKUP_OFFSET" />
                <action android:name="TRIGGER_EYES_ON_WELCOME" />
                <action android:name="COMPLETE_OR_CANCEL_PICKUP" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
